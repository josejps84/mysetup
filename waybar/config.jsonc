{
    "layer": "top",
    "modules-left": ["hyprland/workspaces", "hyprland/submap", "group/media"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["group/volume", "bluetooth", "network", "custom/system-info", "clock"],
    "hyprland/window": {
        "format": "{title}",
        "expand": true
    },
    "battery": {
        "interval": 60,
        "format": "{capacity}% {icon}",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        }
    },
    "bluetooth": {
        // "controller": "controller1", // specify the alias of the controller if there are more than 1 on the system
        "format": "",
        "format-disabled": "", // an empty format will hide the module
        "format-connected": " {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "on-click": "exec ghostty --title=bluetui -e bluetui"
    },
    "cpu": {
        "interval": 10,
        "format": " {}%",
        "max-length": 10,
        "on-click": "exec ghostty --title=btop -e btop"
    },
    "network": {
        "interface": "wlan0",
        "format": "{ifname}",
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
        "tooltip-format-ethernet": "{ifname} ",
        "tooltip-format-disconnected": "",
        "max-length": 50,
        "on-click": "exec nmrs"
    },
    "clock": {
        "format": "{:L%I:%M %p}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "today": "<span color='#ffcc66'><b>{}</b></span>"
            }
        },
        "on-click": "exec brave --app=https://calendar.google.com"
    },
    "memory": {
        "interval": 30,
        "format": "{}% ",
        "max-length": 10,
        "on-click": "exec ghostty --title=htop -e htop"
    },
    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": {
            "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
            "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
            "headphone": "",
            "hands-free": "󰂑",
            "headset": "󰂑",
            "phone": "",
            "phone-muted": "",
            "portable": "",
            "car": "",
            "default": ["", ""]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "group/volume": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "pulseaudio/slider"
        ]
    },
    "group/media": {
        "orientation": "horizontal",
        "modules": [
            "custom/media-icon",
            "custom/media-now-playing",
            "custom/media-time"
        ]
    },
    "custom/media-icon": {
        "escape": true,
        "format": "♪"
    },
    "custom/media-now-playing": {
        "exec": "~/.config/waybar/custom_modules/media/media-now-playing.sh",
        "escape": true,
        "tooltip": false
    },
    "custom/media-time": {
        "exec": "~/.config/waybar/custom_modules/media/media-time.sh",
        "escape": true,
        "tooltip": false,
        "interval": 1
    },
    "custom/system-info": {
        "exec": "~/.config/waybar/custom_modules/system/system-info.sh",
        "return-type": "json",
        "interval": 5, 
        "format": "{}",
        "tooltip": true
    }
}
